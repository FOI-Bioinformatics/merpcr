# Include Cython source files
include src/merpcr/core/*.pyx
include src/merpcr/core/*.pxd

# Include package data
include README.md
include LICENSE
include pyproject.toml
recursive-include docs *.md
recursive-include tests *.py

# Exclude compiled files
global-exclude *.pyc
global-exclude *.pyo
global-exclude *.so
global-exclude *.c
global-exclude *.html
global-exclude __pycache__
